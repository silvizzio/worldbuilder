# Public CDN / S3 base URL for docs media (no trailing slash).
# Unset = use files under public/ (e.g. /demos/... on localhost).
#
# Virtual-hosted S3:
# NEXT_PUBLIC_ASSETS_URL=https://YOUR_BUCKET.s3.ap-southeast-1.amazonaws.com
#
# CloudFront (recommended):
# NEXT_PUBLIC_ASSETS_URL=https://d1234567890.cloudfront.net
#
# GitHub repository media source:
# NEXT_PUBLIC_ASSETS_URL=https://raw.githubusercontent.com/lylywzkj-svg/world-builder-docs/main/public
#
# Path-style (legacy):
# NEXT_PUBLIC_ASSETS_URL=https://s3.ap-southeast-1.amazonaws.com/YOUR_BUCKET
NEXT_PUBLIC_ASSETS_URL=
